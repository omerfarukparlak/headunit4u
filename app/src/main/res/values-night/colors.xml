<?xml version="1.0" encoding="utf-8"?>
<!--
    Koyu tema renkleri. Neo "KOYU_RENKLER" paletinin XML aynasi.
    values/colors.xml ile birebir ayni isimleri kullandigi icin layout dosyalari
    hic degismeden iki temada da dogru renklerle cizilir.
-->
<resources>

    <!-- Neo paleti: koyu (KOYU_RENKLER) -->
    <color name="neo_background_top">#070B1A</color>
    <color name="neo_background_mid">#101426</color>
    <color name="neo_background_bottom">#19122B</color>
    <color name="neo_card">#171B2F</color>
    <color name="neo_card_soft">#20243A</color>
    <color name="neo_card_border">#343A5A</color>
    <color name="neo_primary">#7C5CFF</color>
    <color name="neo_primary_soft">#9B6CFF</color>
    <color name="neo_pink">#FF5BA8</color>
    <color name="neo_orange">#FF8A3D</color>
    <color name="neo_green">#4ADE80</color>
    <color name="neo_blue">#38BDF8</color>
    <color name="neo_text_primary">#F7F7FF</color>
    <color name="neo_text_secondary">#B8BCD5</color>
    <color name="neo_text_muted">#7E849F</color>

    <!-- Fragment layout'larinin kullandigi adlar — koyu tema turevleri -->
    <color name="text_primary">@color/neo_text_primary</color>
    <color name="text_second">@color/neo_text_secondary</color>
    <color name="text_dark">@color/neo_text_secondary</color>
    <color name="adaptive_text_color">@color/neo_text_primary</color>

    <color name="setting_background_color">@color/neo_card</color>
    <color name="primary_dark">@color/neo_background_top</color>
    <color name="divider_color">@color/neo_card_border</color>
    <color name="text_shadow">#00000000</color>
    <color name="segmented_button_stroke">@color/neo_card_border</color>

    <color name="splash_background">@color/neo_background_top</color>
    <color name="splash_text_revived">@color/neo_primary</color>

    <color name="disabled_icon_tint">#40FFFFFF</color>
    <color name="monochrome_icon_tint">@color/neo_text_muted</color>

</resources>
