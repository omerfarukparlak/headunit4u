<?xml version="1.0" encoding="utf-8"?>
<!--
    Neo cam efektli kart arka plani. XML layout'larda <View android:background="@drawable/bg_neo_card" />
    seklinde kullanilabilir. 28dp koseler, Neo card dolgu + ince gradient border.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Kart govdesi -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/neo_card" />
        </shape>
    </item>
    <!-- Ince acik ic dolgu (ustten koyuya dusen gradient) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1AFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Hafif cizgi -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="@color/neo_card_border" />
        </shape>
    </item>
</layer-list>
