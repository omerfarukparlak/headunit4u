<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash logosu: Neo primary dolu yuvarlak + icinde beyaz H4 monogrami.
    Launcher ikonunun daha opak, "halo"lu versiyonu — splash ekraninda tek
    basina gorunur, bu yuzden circle backing eklendi.

    5 adet drawable-*dpi/splash_logo.png birakildi (geriye donuk uyum: eski
    kodun bir yerde o PNG'yi referans etmesi ihtimaline karsi); AAPT density
    secimi oncelikle "drawable/" icin bu vector'u secer, PNG'lere dusmesine
    gerek yok.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="160dp"
    android:height="160dp"
    android:viewportWidth="160"
    android:viewportHeight="160">

    <!-- Yuvarlak Neo primary zemin, hafif Neo primary_soft tonu merkezde -->
    <path android:fillColor="#7C5CFF"
        android:pathData="M80,8 a72,72 0 1 0 0.1,0 Z" />

    <!-- Ic halka (hafif beyaz halo) -->
    <path android:fillColor="#1AFFFFFF"
        android:pathData="M80,20 a60,60 0 1 0 0.1,0 Z" />

    <!-- H harfi (merkezin solu) -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M44,56 L54,56 L54,76 L72,76 L72,56 L82,56 L82,104 L72,104 L72,86 L54,86 L54,104 L44,104 Z" />

    <!-- 4 rakami (merkezin sagi) -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M90,56 L98,56 L98,76 L108,76 L108,84 L98,84 L98,104 L90,104 L90,84 L78,84 L78,76 L90,76 Z" />
</vector>
