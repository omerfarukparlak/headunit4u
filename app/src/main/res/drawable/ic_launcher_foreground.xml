<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher adaptive icon foreground. 108dp canvas, safe zone 66dp merkezde.
    Zemin ic_launcher_background (Neo primary #7C5CFF). Foreground: beyaz "H"
    harfi + saga minimalist "4" rakami — HeadUnit4u markasinin kompakt monogrami.
    Letterform geometric bold, yuvarlak koseler yok (adaptive mask zaten kirpiyor).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- H (sol) : iki dikey + orta yatay birlesik path -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M28,34 L38,34 L38,52 L52,52 L52,34 L62,34 L62,74 L52,74 L52,62 L38,62 L38,74 L28,74 Z" />

    <!-- 4 (sag): dikey ana cubuk + iki uzanti -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M68,34 L74,34 L74,52 L80,52 L80,58 L74,58 L74,74 L68,74 L68,58 L58,58 L58,52 L68,52 Z" />
</vector>
