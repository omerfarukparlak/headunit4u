<?xml version="1.0" encoding="utf-8"?>
<!--
    ThemeOverlay.GradientBackground icin alternatif gradient — mor-pembe karisimli,
    dekoratif ekranlarda (About, splash sonrasi) kullanilabilir. Light/dark tema
    icin renk referanslari uzerinden otomatik degisir.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="@color/neo_background_top"
        android:centerColor="@color/neo_primary"
        android:endColor="@color/neo_pink" />
</shape>
